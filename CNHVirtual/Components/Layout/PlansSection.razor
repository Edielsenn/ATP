@inject HttpClient Http
@inject IConfiguration Configuration

<section id="cursos" class="plans-section">
    <div class="container">
        <h2 class="section-title">
            Escolha o <span style="color: #0081f2;">Plano Ideal</span> para Você
        </h2>
        <p class="section-subtitle">
            Planos completos para você conquistar sua CNH com segurança e economia
        </p>

        @if (isLoading)
        {
            <div style="text-align: center; padding: 3rem;">
                <p style="font-size: 1.25rem; color: #718096;">Carregando planos...</p>
            </div>
        }
        else if (plans.Any())
        {
            <div class="cards-grid">
                @foreach (var plan in plans)
                {
                    <PlanCard Plan="@plan" />
                }
            </div>

            <div style="margin-top: 3rem; text-align: center; color: #4a5568;">
                <p>✅ Pagamento 100% seguro • ✅ Acesso imediato • ✅ Garantia de 7 dias</p>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 3rem;">
                <p style="font-size: 1.25rem; color: #e53e3e;">
                    Não foi possível carregar os planos. Tente novamente mais tarde.
                </p>
            </div>
        }
    </div>
</section>

@code {
    private List<Plan> plans = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://localhost:5273";
            plans = await Http.GetFromJsonAsync<List<Plan>>($"{apiUrl}/api/planos") ?? new();
        }
        catch
        {
            // Em caso de erro, usar dados mockados
            plans = GetMockPlans();
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<Plan> GetMockPlans()
    {
        return new List<Plan>
        {
            new Plan
            {
                Id = 1,
                Nome = "Plano Básico",
                DescricaoCurta = "Ideal para iniciantes",
                Preco = 97.00m,
                DuracaoDias = 90,
                Destaque = false,
                Recursos = new List<PlanResource>
                {
                    new() { Descricao = "Acesso por 90 dias", Incluido = true },
                    new() { Descricao = "Todo conteúdo teórico", Incluido = true },
                    new() { Descricao = "Questões comentadas", Incluido = true },
                    new() { Descricao = "3 tentativas de simulado", Incluido = true },
                    new() { Descricao = "Suporte por email", Incluido = true },
                    new() { Descricao = "Certificado digital", Incluido = true }
                }
            },
            new Plan
            {
                Id = 2,
                Nome = "Plano Intermediário",
                DescricaoCurta = "Mais vendido",
                Preco = 197.00m,
                DuracaoDias = 180,
                Destaque = true,
                Recursos = new List<PlanResource>
                {
                    new() { Descricao = "Acesso por 180 dias", Incluido = true },
                    new() { Descricao = "Todo conteúdo teórico", Incluido = true },
                    new() { Descricao = "Questões comentadas", Incluido = true },
                    new() { Descricao = "Simulados ilimitados", Incluido = true },
                    new() { Descricao = "Estatísticas de desempenho", Incluido = true },
                    new() { Descricao = "Suporte prioritário", Incluido = true },
                    new() { Descricao = "Certificado digital", Incluido = true },
                    new() { Descricao = "Material em PDF", Incluido = true }
                }
            },
            new Plan
            {
                Id = 3,
                Nome = "Plano Premium",
                DescricaoCurta = "Garantia de aprovação",
                Preco = 397.00m,
                DuracaoDias = 3650,
                Destaque = false,
                Recursos = new List<PlanResource>
                {
                    new() { Descricao = "Acesso vitalício", Incluido = true },
                    new() { Descricao = "Todo conteúdo teórico", Incluido = true },
                    new() { Descricao = "Questões comentadas", Incluido = true },
                    new() { Descricao = "Simulados ilimitados", Incluido = true },
                    new() { Descricao = "Aulas práticas em vídeo", Incluido = true },
                    new() { Descricao = "Estatísticas avançadas", Incluido = true },
                    new() { Descricao = "Suporte VIP 24/7", Incluido = true },
                    new() { Descricao = "Certificado digital", Incluido = true },
                    new() { Descricao = "Material completo em PDF", Incluido = true },
                    new() { Descricao = "Garantia de aprovação", Incluido = true },
                    new() { Descricao = "Atualizações gratuitas", Incluido = true }
                }
            }
        };
    }

    public class Plan
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string DescricaoCurta { get; set; } = "";
        public decimal Preco { get; set; }
        public decimal? PrecoPromocional { get; set; }
        public int DuracaoDias { get; set; }
        public bool Destaque { get; set; }
        public List<PlanResource> Recursos { get; set; } = new();
    }

    public class PlanResource
    {
        public string Descricao { get; set; } = "";
        public bool Incluido { get; set; }
    }
}

<style>
    .plans-section {
        padding: 6rem 2rem;
        background: #f7fafc;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .section-title {
        font-size: 3rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 1rem;
        color: #1a202c;
    }

    .section-subtitle {
        font-size: 1.25rem;
        text-align: center;
        color: #718096;
        margin-bottom: 4rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        margin-bottom: 2rem;
    }

    @@media (max-width: 768px) {
        .section-title {
            font-size: 2rem;
        }

        .section-subtitle {
            font-size: 1.1rem;
        }

        .cards-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
