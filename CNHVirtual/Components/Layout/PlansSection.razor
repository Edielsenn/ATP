@inject HttpClient Http
@inject IConfiguration Configuration

<section id="cursos" class="plans-section">
    <div class="container">
        <h2 class="section-title">
            Escolha o <span style="color: #0081f2;">Plano Ideal</span> para Você
        </h2>
        <p class="section-subtitle">
            Planos completos para você conquistar sua CNH com segurança e economia
        </p>

        @if (isLoading)
        {
            <div style="text-align: center; padding: 3rem;">
                <p style="font-size: 1.25rem; color: #718096;">Carregando planos...</p>
            </div>
        }
        else if (plans.Any())
        {
            <div class="cards-grid">
                @foreach (var plan in plans)
                {
                    <PlanCard Plan="@plan" />
                }
            </div>

            <div style="margin-top: 3rem; text-align: center; color: #4a5568;">
                <p>✅ Pagamento 100% seguro • ✅ Acesso imediato • ✅ Garantia de 7 dias</p>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 3rem;">
                <p style="font-size: 1.25rem; color: #e53e3e;">
                    Não foi possível carregar os planos. Tente novamente mais tarde.
                </p>
            </div>
        }
    </div>
</section>

@code {
    private List<Plan> plans = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://localhost:5273";
            Console.WriteLine($"[PLANOS CLIENTE] Buscando planos em: {apiUrl}/api/planos");

            plans = await Http.GetFromJsonAsync<List<Plan>>($"{apiUrl}/api/planos") ?? new();

            Console.WriteLine($"[PLANOS CLIENTE] {plans.Count} planos recebidos da API");
            if (plans.Any())
            {
                foreach (var plan in plans)
                {
                    Console.WriteLine($"[PLANOS CLIENTE] - {plan.Nome} (Ativo: {plan.Ativo}, Recursos: {plan.Recursos.Count})");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PLANOS CLIENTE] Erro ao buscar planos: {ex.Message}");
            // Em caso de erro, usar dados mockados
            plans = GetMockPlans();
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<Plan> GetMockPlans()
    {
        return new List<Plan>
        {
            new Plan
            {
                Id = 1,
                Nome = "Plano Básico",
                Descricao = "Ideal para iniciantes",
                Preco = 97.00m,
                DuracaoDias = 90,
                Destaque = false,
                Ativo = true,
                Recursos = new List<string>
                {
                    "Acesso por 90 dias",
                    "Todo conteúdo teórico",
                    "Questões comentadas",
                    "3 tentativas de simulado",
                    "Suporte por email",
                    "Certificado digital"
                }
            },
            new Plan
            {
                Id = 2,
                Nome = "Plano Intermediário",
                Descricao = "Mais vendido",
                Preco = 197.00m,
                DuracaoDias = 180,
                Destaque = true,
                Ativo = true,
                Recursos = new List<string>
                {
                    "Acesso por 180 dias",
                    "Todo conteúdo teórico",
                    "Questões comentadas",
                    "Simulados ilimitados",
                    "Estatísticas de desempenho",
                    "Suporte prioritário",
                    "Certificado digital",
                    "Material em PDF"
                }
            },
            new Plan
            {
                Id = 3,
                Nome = "Plano Premium",
                Descricao = "Garantia de aprovação",
                Preco = 397.00m,
                DuracaoDias = 3650,
                Destaque = false,
                Ativo = true,
                Recursos = new List<string>
                {
                    "Acesso vitalício",
                    "Todo conteúdo teórico",
                    "Questões comentadas",
                    "Simulados ilimitados",
                    "Aulas práticas em vídeo",
                    "Estatísticas avançadas",
                    "Suporte VIP 24/7",
                    "Certificado digital",
                    "Material completo em PDF",
                    "Garantia de aprovação",
                    "Atualizações gratuitas"
                }
            }
        };
    }

    public class Plan
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Descricao { get; set; } = "";
        public decimal Preco { get; set; }
        public decimal? PrecoPromocional { get; set; }
        public int DuracaoDias { get; set; }
        public bool Destaque { get; set; }
        public bool Ativo { get; set; }
        public List<string> Recursos { get; set; } = new();
    }
}

<style>
    .plans-section {
        padding: 6rem 2rem;
        background: #f7fafc;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .section-title {
        font-size: 3rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 1rem;
        color: #1a202c;
    }

    .section-subtitle {
        font-size: 1.25rem;
        text-align: center;
        color: #718096;
        margin-bottom: 4rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        margin-bottom: 2rem;
    }

    @@media (max-width: 768px) {
        .section-title {
            font-size: 2rem;
        }

        .section-subtitle {
            font-size: 1.1rem;
        }

        .cards-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
