@code {
    private List<PlanoDto> planos = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private PlanoFormDto planoForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPlanos();
    }

    private async Task LoadPlanos()
    {
        try
        {
            isLoading = true;
            Console.WriteLine("[PLANOS] Carregando planos da API...");

            planos = await ApiService.GetAsync<List<PlanoDto>>("/api/planos") ?? new List<PlanoDto>();

            Console.WriteLine($"[PLANOS] {planos.Count} planos carregados");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PLANOS] Erro ao carregar: {ex.Message}");
            planos = new List<PlanoDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenNovoPlanoModal()
    {
        planoForm = new PlanoFormDto
        {
            Ativo = true,
            Destaque = false,
            Ordem = 0,
            Recursos = new List<RecursoDto>()
        };
        isEditMode = false;
        showModal = true;
    }

    private async Task EditPlano(int id)
    {
        try
        {
            Console.WriteLine($"[PLANOS] Carregando plano {id} para edição...");

            var plano = planos.FirstOrDefault(p => p.Id == id);
            if (plano == null) return;

            planoForm = new PlanoFormDto
            {
                Id = plano.Id,
                Nome = plano.Nome,
                Descricao = plano.Descricao,
                Preco = plano.Preco,
                PrecoPromocional = plano.PrecoPromocional,
                DuracaoDias = plano.DuracaoDias,
                Destaque = plano.Destaque,
                Ativo = plano.Ativo,
                Ordem = 0,
                Recursos = plano.Recursos.Select((r, index) => new RecursoDto
                {
                    Descricao = r,
                    Incluido = true,
                    Ordem = index
                }).ToList()
            };

            isEditMode = true;
            showModal = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PLANOS] Erro ao carregar plano: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        showModal = false;
        planoForm = new();
    }

    private void AdicionarRecurso()
    {
        planoForm.Recursos.Add(new RecursoDto { Descricao = "", Incluido = true, Ordem = planoForm.Recursos.Count });
    }

    private void RemoverRecurso(int index)
    {
        planoForm.Recursos.RemoveAt(index);
    }

    private async Task SalvarPlano()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(planoForm.Nome) || planoForm.Preco <= 0 || planoForm.DuracaoDias <= 0)
            {
                Console.WriteLine("[PLANOS] Validação falhou - campos obrigatórios não preenchidos");
                return;
            }

            isSaving = true;

            if (isEditMode)
            {
                Console.WriteLine($"[PLANOS] Atualizando plano {planoForm.Id}...");
                await ApiService.PutAsync<PlanoFormDto, object>($"/api/planos/{planoForm.Id}", planoForm);
            }
            else
            {
                Console.WriteLine("[PLANOS] Criando novo plano...");
                await ApiService.PostAsync<PlanoFormDto, object>("/api/planos", planoForm);
            }

            Console.WriteLine("[PLANOS] Operação concluída, recarregando lista...");
            await LoadPlanos();
            CloseModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PLANOS] Erro ao salvar plano: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleStatus(int id)
    {
        try
        {
            Console.WriteLine($"[PLANOS] Alternando status do plano {id}");

            var response = await ApiService.PutAsync<object, object>($"/api/planos/{id}/toggle-status", null);

            if (response != null)
            {
                Console.WriteLine("[PLANOS] Status alterado, recarregando lista...");
                await LoadPlanos();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PLANOS] Erro ao alternar status: {ex.Message}");
        }
    }

    public class PlanoFormDto
    {
        public int Id { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string? Descricao { get; set; }
        public decimal Preco { get; set; }
        public decimal? PrecoPromocional { get; set; }
        public int DuracaoDias { get; set; }
        public bool Destaque { get; set; }
        public bool Ativo { get; set; }
        public int Ordem { get; set; }
        public List<RecursoDto> Recursos { get; set; } = new();
    }

    public class RecursoDto
    {
        public string Descricao { get; set; } = string.Empty;
        public bool Incluido { get; set; } = true;
        public int Ordem { get; set; }
    }
}
