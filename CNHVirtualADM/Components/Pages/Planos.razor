@page "/planos"
@rendermode InteractiveServer
@inject ApiService ApiService

<PageTitle>Planos - CNH Virtual Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Planos</h1>
            <p>Gerenciamento de planos e preços</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Carregando planos...</p>
        </div>
    }
    else if (planos.Any())
    {
        <div class="planos-grid">
            @foreach (var plano in planos)
            {
                <div class="plano-card @(plano.Destaque ? "featured" : "") @(!plano.Ativo ? "inactive" : "")">
                    @if (plano.Destaque)
                    {
                        <div class="plano-badge">⭐ DESTAQUE</div>
                    }
                    @if (!plano.Ativo)
                    {
                        <div class="plano-badge inactive-badge">❌ INATIVO</div>
                    }

                    <div class="plano-header">
                        <h3>@plano.Nome</h3>
                        <p class="plano-descricao">@plano.Descricao</p>
                    </div>

                    <div class="plano-price">
                        @if (plano.PrecoPromocional.HasValue)
                        {
                            <span class="price-original">R$ @plano.Preco.ToString("N2")</span>
                            <span class="price-promo">R$ @plano.PrecoPromocional.Value.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="price-main">R$ @plano.Preco.ToString("N2")</span>
                        }
                        <span class="price-period">/ @plano.DuracaoDias dias</span>
                    </div>

                    <div class="plano-recursos">
                        <h4>Recursos inclusos:</h4>
                        <ul>
                            @foreach (var recurso in plano.Recursos)
                            {
                                <li>✓ @recurso</li>
                            }
                        </ul>
                    </div>

                    <div class="plano-actions">
                        <button @onclick="() => EditPlano(plano.Id)" class="btn btn-primary">
                            Editar
                        </button>
                        <button @onclick="() => ToggleStatus(plano.Id)" class="btn @(plano.Ativo ? "btn-danger" : "btn-success")">
                            @(plano.Ativo ? "Desativar" : "Ativar")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <h3>Nenhum plano encontrado</h3>
            <p>Não há planos cadastrados no sistema ainda.</p>
        </div>
    }
</div>

<style>
    .page-container {
        padding: 20px;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0 0 8px 0;
        font-size: 32px;
        color: #333;
    }

    .page-header p {
        margin: 0;
        color: #666;
    }

    .planos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
    }

    .plano-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        position: relative;
        transition: transform 0.3s, box-shadow 0.3s;
        border: 2px solid transparent;
    }

    .plano-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .plano-card.featured {
        border-color: #0081f2;
        background: linear-gradient(135deg, #f0f8ff 0%, #ffffff 100%);
    }

    .plano-card.inactive {
        opacity: 0.6;
    }

    .plano-badge {
        position: absolute;
        top: 16px;
        right: 16px;
        background: #0081f2;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 0.5px;
    }

    .inactive-badge {
        background: #f44336;
    }

    .plano-header {
        margin-bottom: 24px;
    }

    .plano-header h3 {
        margin: 0 0 8px 0;
        font-size: 24px;
        color: #333;
    }

    .plano-descricao {
        margin: 0;
        color: #666;
        font-size: 14px;
        line-height: 1.5;
    }

    .plano-price {
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 2px solid #e9ecef;
    }

    .price-original {
        display: block;
        color: #999;
        text-decoration: line-through;
        font-size: 18px;
        margin-bottom: 4px;
    }

    .price-promo {
        display: block;
        color: #0081f2;
        font-size: 36px;
        font-weight: bold;
    }

    .price-main {
        display: block;
        color: #0081f2;
        font-size: 36px;
        font-weight: bold;
    }

    .price-period {
        display: block;
        color: #666;
        font-size: 14px;
        margin-top: 4px;
    }

    .plano-recursos {
        margin-bottom: 24px;
    }

    .plano-recursos h4 {
        margin: 0 0 12px 0;
        font-size: 16px;
        color: #333;
    }

    .plano-recursos ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .plano-recursos li {
        padding: 8px 0;
        color: #666;
        font-size: 14px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .plano-actions {
        display: flex;
        gap: 8px;
    }

    .btn {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-primary {
        background: #0081f2;
        color: white;
    }

    .btn-primary:hover {
        background: #0066c2;
    }

    .btn-success {
        background: #4caf50;
        color: white;
    }

    .btn-success:hover {
        background: #388e3c;
    }

    .btn-danger {
        background: #f44336;
        color: white;
    }

    .btn-danger:hover {
        background: #d32f2f;
    }

    .empty-state {
        background: white;
        border-radius: 12px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .empty-state h3 {
        margin: 0 0 8px 0;
        color: #333;
    }

    .empty-state p {
        margin: 0;
        color: #666;
    }

    .loading-container {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #0081f2;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@code {
    private List<PlanoDto> planos = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlanos();
    }

    private async Task LoadPlanos()
    {
        try
        {
            isLoading = true;

            // Tentar carregar da API real
            var result = await ApiService.GetAsync<List<PlanoDto>>("/api/planos");
            if (result != null && result.Any())
            {
                planos = result;
            }
            else
            {
                // Fallback para mock data
                await Task.Delay(500);
                planos = GetMockPlanos();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar planos: {ex.Message}");
            // Em caso de erro, usar mock data
            planos = GetMockPlanos();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditPlano(int id)
    {
        // TODO: Implementar modal de edição
        Console.WriteLine($"Editar plano {id}");
    }

    private async Task ToggleStatus(int id)
    {
        // TODO: Implementar ativação/desativação via API
        var plano = planos.FirstOrDefault(p => p.Id == id);
        if (plano != null)
        {
            plano.Ativo = !plano.Ativo;
            StateHasChanged();
        }
    }

    private List<PlanoDto> GetMockPlanos()
    {
        return new List<PlanoDto>
        {
            new() {
                Id = 1,
                Nome = "Plano Básico",
                Descricao = "Ideal para quem está começando",
                Preco = 97.00m,
                DuracaoDias = 30,
                Destaque = false,
                Ativo = true,
                Recursos = new List<string> {
                    "Acesso à plataforma por 30 dias",
                    "Videoaulas completas",
                    "Exercícios práticos",
                    "Suporte via chat"
                }
            },
            new() {
                Id = 2,
                Nome = "Plano Intermediário",
                Descricao = "Mais recursos e tempo",
                Preco = 197.00m,
                DuracaoDias = 60,
                Destaque = true,
                Ativo = true,
                Recursos = new List<string> {
                    "Acesso à plataforma por 60 dias",
                    "Videoaulas completas",
                    "Exercícios práticos",
                    "Simulados ilimitados",
                    "Suporte prioritário"
                }
            },
            new() {
                Id = 3,
                Nome = "Plano Premium",
                Descricao = "Acesso completo e ilimitado",
                Preco = 397.00m,
                DuracaoDias = 90,
                Destaque = false,
                Ativo = true,
                Recursos = new List<string> {
                    "Acesso à plataforma por 90 dias",
                    "Videoaulas completas",
                    "Exercícios práticos",
                    "Simulados ilimitados",
                    "Mentoria individual",
                    "Material em PDF",
                    "Suporte VIP 24/7"
                }
            }
        };
    }
}
