@page "/planos"
@rendermode InteractiveServer
@inject ApiService ApiService

<PageTitle>Planos - CNH Virtual Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Planos</h1>
            <p>Gerenciamento de planos e preços</p>
        </div>
        <button @onclick="OpenNovoPlanoModal" class="btn btn-primary btn-novo">
            ➕ Novo Plano
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Carregando planos...</p>
        </div>
    }
    else if (planos.Any())
    {
        <div class="planos-grid">
            @foreach (var plano in planos)
            {
                <div class="plano-card @(plano.Destaque ? "featured" : "") @(!plano.Ativo ? "inactive" : "")">
                    @if (plano.Destaque)
                    {
                        <div class="plano-badge">⭐ DESTAQUE</div>
                    }
                    @if (!plano.Ativo)
                    {
                        <div class="plano-badge inactive-badge">❌ INATIVO</div>
                    }

                    <div class="plano-header">
                        <h3>@plano.Nome</h3>
                        <p class="plano-descricao">@plano.Descricao</p>
                    </div>

                    <div class="plano-price">
                        @if (plano.PrecoPromocional.HasValue)
                        {
                            <span class="price-original">R$ @plano.Preco.ToString("N2")</span>
                            <span class="price-promo">R$ @plano.PrecoPromocional.Value.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="price-main">R$ @plano.Preco.ToString("N2")</span>
                        }
                        <span class="price-period">/ @plano.DuracaoDias dias</span>
                    </div>

                    <div class="plano-recursos">
                        <h4>Recursos inclusos:</h4>
                        <ul>
                            @foreach (var recurso in plano.Recursos)
                            {
                                <li>✓ @recurso</li>
                            }
                        </ul>
                    </div>

                    <div class="plano-actions">
                        <button @onclick="() => EditPlano(plano.Id)" class="btn btn-primary">
                            Editar
                        </button>
                        <button @onclick="() => ToggleStatus(plano.Id)" class="btn @(plano.Ativo ? "btn-danger" : "btn-success")">
                            @(plano.Ativo ? "Desativar" : "Ativar")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <h3>Nenhum plano encontrado</h3>
            <p>Não há planos cadastrados no sistema ainda.</p>
        </div>
    }

    @if (showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>@(isEditMode ? "Editar Plano" : "Novo Plano")</h2>
                    <button @onclick="CloseModal" class="btn-close">✕</button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label>Nome do Plano *</label>
                        <input @bind="planoForm.Nome" type="text" class="form-control" placeholder="Ex: Plano Premium" />
                    </div>

                    <div class="form-group">
                        <label>Descrição</label>
                        <textarea @bind="planoForm.Descricao" class="form-control" rows="3" placeholder="Descrição do plano"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Preço (R$) *</label>
                            <input @bind="planoForm.Preco" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>

                        <div class="form-group">
                            <label>Preço Promocional (R$)</label>
                            <input @bind="planoForm.PrecoPromocional" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Duração (dias) *</label>
                        <input @bind="planoForm.DuracaoDias" type="number" class="form-control" placeholder="30" />
                    </div>

                    <div class="form-checks">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="planoForm.Destaque" />
                            <span>Plano em Destaque</span>
                        </label>

                        <label class="checkbox-label">
                            <input type="checkbox" @bind="planoForm.Ativo" />
                            <span>Plano Ativo</span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Ordem de Exibição</label>
                        <input @bind="planoForm.Ordem" type="number" class="form-control" placeholder="0" />
                    </div>

                    <div class="form-group">
                        <label>Recursos do Plano</label>
                        <div class="recursos-list">
                            @for (int i = 0; i < planoForm.Recursos.Count; i++)
                            {
                                var index = i;
                                <div class="recurso-item">
                                    <input @bind="planoForm.Recursos[index].Descricao" type="text" class="form-control" placeholder="Descrição do recurso" />
                                    <button @onclick="() => RemoverRecurso(index)" class="btn btn-danger btn-sm">✕</button>
                                </div>
                            }
                        </div>
                        <button @onclick="AdicionarRecurso" class="btn btn-secondary btn-sm mt-2">➕ Adicionar Recurso</button>
                    </div>
                </div>

                <div class="modal-footer">
                    <button @onclick="CloseModal" class="btn btn-secondary">Cancelar</button>
                    <button @onclick="SalvarPlano" class="btn btn-primary" disabled="@isSaving">
                        @(isSaving ? "Salvando..." : "Salvar")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

