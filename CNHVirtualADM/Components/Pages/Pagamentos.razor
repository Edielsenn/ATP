@page "/pagamentos"
@rendermode InteractiveServer
@inject ApiService ApiService

<PageTitle>Pagamentos - CNH Virtual Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Pagamentos</h1>
            <p>Gerenciamento de pagamentos e transações</p>
        </div>
        <div class="header-actions">
            <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Buscar por cliente, email..." class="search-input" />
            <select @bind="filterStatus" class="filter-select">
                <option value="">Todos os status</option>
                <option value="PENDING">Pendente</option>
                <option value="CONFIRMED">Confirmado</option>
                <option value="RECEIVED">Recebido</option>
                <option value="OVERDUE">Vencido</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Carregando pagamentos...</p>
        </div>
    }
    else if (filteredPagamentos.Any())
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Cliente</th>
                        <th>Plano</th>
                        <th>Valor</th>
                        <th>Forma</th>
                        <th>Status</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pagamento in filteredPagamentos)
                    {
                        <tr>
                            <td><span class="badge badge-light">@pagamento.NumeroPedido</span></td>
                            <td>
                                <div class="client-info">
                                    <strong>@pagamento.ClienteNome</strong>
                                    <small>@pagamento.ClienteEmail</small>
                                </div>
                            </td>
                            <td>@pagamento.PlanoNome</td>
                            <td><strong>R$ @pagamento.Valor.ToString("N2")</strong></td>
                            <td>
                                <span class="badge badge-info">
                                    @(pagamento.FormaPagamento == "BOLETO" ? "Boleto" : "Cartão")
                                </span>
                            </td>
                            <td>
                                <span class="badge @GetStatusClass(pagamento.Status)">
                                    @GetStatusText(pagamento.Status)
                                </span>
                            </td>
                            <td>
                                <small>@pagamento.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <button @onclick="() => ViewDetails(pagamento.Id)" class="btn-icon" title="Ver detalhes">
                                    👁️
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="summary-cards">
            <div class="summary-card">
                <strong>Total de Pagamentos</strong>
                <span>@pagamentos.Count</span>
            </div>
            <div class="summary-card">
                <strong>Valor Total</strong>
                <span>R$ @pagamentos.Sum(p => p.Valor).ToString("N2")</span>
            </div>
            <div class="summary-card">
                <strong>Confirmados</strong>
                <span>@pagamentos.Count(p => p.Status == "CONFIRMED" || p.Status == "RECEIVED")</span>
            </div>
            <div class="summary-card">
                <strong>Pendentes</strong>
                <span>@pagamentos.Count(p => p.Status == "PENDING")</span>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">💳</div>
            <h3>Nenhum pagamento encontrado</h3>
            <p>Não há pagamentos registrados no sistema ainda.</p>
        </div>
    }
</div>

<style>
    .page-container {
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .page-header h1 {
        margin: 0 0 8px 0;
        font-size: 32px;
        color: #333;
    }

    .page-header p {
        margin: 0;
        color: #666;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    .search-input {
        padding: 10px 16px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        min-width: 250px;
    }

    .filter-select {
        padding: 10px 16px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        background: white;
        cursor: pointer;
    }

    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table thead {
        background: #f8f9fa;
    }

    .data-table th {
        padding: 16px;
        text-align: left;
        font-weight: 600;
        color: #333;
        font-size: 14px;
        border-bottom: 2px solid #e9ecef;
    }

    .data-table td {
        padding: 16px;
        border-bottom: 1px solid #e9ecef;
        font-size: 14px;
    }

    .data-table tbody tr:hover {
        background: #f8f9fa;
    }

    .client-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .client-info strong {
        color: #333;
    }

    .client-info small {
        color: #666;
        font-size: 12px;
    }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-light {
        background: #e9ecef;
        color: #495057;
    }

    .badge-info {
        background: #e3f2fd;
        color: #1976d2;
    }

    .badge-success {
        background: #e8f5e9;
        color: #388e3c;
    }

    .badge-warning {
        background: #fff3e0;
        color: #f57c00;
    }

    .badge-danger {
        background: #ffebee;
        color: #d32f2f;
    }

    .btn-icon {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        transition: background 0.2s;
    }

    .btn-icon:hover {
        background: #e9ecef;
    }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .summary-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .summary-card strong {
        color: #666;
        font-size: 14px;
    }

    .summary-card span {
        color: #0081f2;
        font-size: 24px;
        font-weight: bold;
    }

    .empty-state {
        background: white;
        border-radius: 12px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .empty-state h3 {
        margin: 0 0 8px 0;
        color: #333;
    }

    .empty-state p {
        margin: 0;
        color: #666;
    }

    .loading-container {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #0081f2;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@code {
    private List<PagamentoDto> pagamentos = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string filterStatus = string.Empty;

    private IEnumerable<PagamentoDto> filteredPagamentos => pagamentos
        .Where(p => string.IsNullOrEmpty(searchTerm) ||
                   p.ClienteNome.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                   p.ClienteEmail.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                   p.NumeroPedido.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(filterStatus) || p.Status == filterStatus)
        .OrderByDescending(p => p.DataCriacao);

    protected override async Task OnInitializedAsync()
    {
        await LoadPagamentos();
    }

    private async Task LoadPagamentos()
    {
        try
        {
            isLoading = true;

            // TODO: Criar endpoint /api/admin/pagamentos na API
            // var result = await ApiService.GetAsync<List<PagamentoDto>>("/api/admin/pagamentos");
            // if (result != null) pagamentos = result;

            // Mock data por enquanto
            await Task.Delay(500);
            pagamentos = GetMockPagamentos();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar pagamentos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewDetails(int id)
    {
        // TODO: Implementar modal de detalhes
        Console.WriteLine($"Ver detalhes do pagamento {id}");
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "CONFIRMED" or "RECEIVED" => "badge-success",
            "PENDING" => "badge-warning",
            "OVERDUE" => "badge-danger",
            _ => "badge-light"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "PENDING" => "Pendente",
            "CONFIRMED" => "Confirmado",
            "RECEIVED" => "Recebido",
            "OVERDUE" => "Vencido",
            _ => status
        };
    }

    private List<PagamentoDto> GetMockPagamentos()
    {
        return new List<PagamentoDto>
        {
            new() {
                Id = 1,
                NumeroPedido = "PED-2024-001",
                ClienteNome = "João Silva",
                ClienteEmail = "joao@email.com",
                PlanoNome = "Plano Básico",
                Valor = 97.00m,
                FormaPagamento = "BOLETO",
                Status = "CONFIRMED",
                DataCriacao = DateTime.Now.AddDays(-5)
            },
            new() {
                Id = 2,
                NumeroPedido = "PED-2024-002",
                ClienteNome = "Maria Santos",
                ClienteEmail = "maria@email.com",
                PlanoNome = "Plano Intermediário",
                Valor = 197.00m,
                FormaPagamento = "CREDIT_CARD",
                Status = "RECEIVED",
                DataCriacao = DateTime.Now.AddDays(-3)
            },
            new() {
                Id = 3,
                NumeroPedido = "PED-2024-003",
                ClienteNome = "Pedro Oliveira",
                ClienteEmail = "pedro@email.com",
                PlanoNome = "Plano Premium",
                Valor = 397.00m,
                FormaPagamento = "CREDIT_CARD",
                Status = "PENDING",
                DataCriacao = DateTime.Now.AddDays(-1)
            }
        };
    }
}
