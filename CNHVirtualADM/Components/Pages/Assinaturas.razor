@page "/assinaturas"
@rendermode InteractiveServer
@inject ApiService ApiService

<PageTitle>Assinaturas - CNH Virtual Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Assinaturas</h1>
            <p>Gerenciamento de assinaturas ativas</p>
        </div>
        <div class="header-actions">
            <select @bind="filterStatus" class="filter-select">
                <option value="">Todos os status</option>
                <option value="ACTIVE">Ativas</option>
                <option value="EXPIRED">Expiradas</option>
                <option value="CANCELLED">Canceladas</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Carregando assinaturas...</p>
        </div>
    }
    else
    {
        <div class="stats-row">
            <div class="stat-box active">
                <h3>Ativas</h3>
                <p>@assinaturas.Count(a => a.Status == "ACTIVE")</p>
            </div>
            <div class="stat-box expired">
                <h3>Expiradas</h3>
                <p>@assinaturas.Count(a => a.Status == "EXPIRED")</p>
            </div>
            <div class="stat-box cancelled">
                <h3>Canceladas</h3>
                <p>@assinaturas.Count(a => a.Status == "CANCELLED")</p>
            </div>
        </div>

        @if (filteredAssinaturas.Any())
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Plano</th>
                            <th>Data Início</th>
                            <th>Data Fim</th>
                            <th>Status</th>
                            <th>Dias Restantes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assinatura in filteredAssinaturas)
                        {
                            var diasRestantes = (assinatura.DataFim - DateTime.Now).Days;
                            <tr>
                                <td><span class="badge badge-light">#@assinatura.Id</span></td>
                                <td>
                                    <div class="client-info">
                                        <strong>@assinatura.ClienteNome</strong>
                                        <small>@assinatura.ClienteEmail</small>
                                    </div>
                                </td>
                                <td>@assinatura.PlanoNome</td>
                                <td><small>@assinatura.DataInicio.ToString("dd/MM/yyyy")</small></td>
                                <td><small>@assinatura.DataFim.ToString("dd/MM/yyyy")</small></td>
                                <td>
                                    <span class="badge @GetStatusClass(assinatura.Status)">
                                        @GetStatusText(assinatura.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (diasRestantes > 0 && assinatura.Status == "ACTIVE")
                                    {
                                        <span class="dias-restantes">@diasRestantes dias</span>
                                    }
                                    else
                                    {
                                        <span class="dias-restantes expired">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">🎓</div>
                <h3>Nenhuma assinatura encontrada</h3>
                <p>Não há assinaturas com os filtros selecionados.</p>
            </div>
        }
    }
</div>

<style>
    .page-container { padding: 20px; }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }
    .page-header h1 { margin: 0 0 8px 0; font-size: 32px; color: #333; }
    .page-header p { margin: 0; color: #666; }
    .header-actions { display: flex; gap: 12px; }
    .filter-select {
        padding: 10px 16px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        background: white;
        cursor: pointer;
    }
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    .stat-box {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border-left: 4px solid;
    }
    .stat-box.active { border-color: #4caf50; }
    .stat-box.expired { border-color: #ff9800; }
    .stat-box.cancelled { border-color: #f44336; }
    .stat-box h3 { margin: 0 0 8px 0; font-size: 14px; color: #666; }
    .stat-box p { margin: 0; font-size: 32px; font-weight: bold; color: #333; }
    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow-x: auto;
    }
    .data-table { width: 100%; border-collapse: collapse; min-width: 800px; }
    .data-table thead { background: #f8f9fa; }
    .data-table th {
        padding: 16px;
        text-align: left;
        font-weight: 600;
        color: #333;
        font-size: 14px;
        border-bottom: 2px solid #e9ecef;
    }
    .data-table td { padding: 16px; border-bottom: 1px solid #e9ecef; font-size: 14px; }
    .data-table tbody tr:hover { background: #f8f9fa; }
    .client-info { display: flex; flex-direction: column; gap: 4px; }
    .client-info strong { color: #333; }
    .client-info small { color: #666; font-size: 12px; }
    .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    .badge-light { background: #e9ecef; color: #495057; }
    .badge-success { background: #e8f5e9; color: #388e3c; }
    .badge-warning { background: #fff3e0; color: #f57c00; }
    .badge-danger { background: #ffebee; color: #d32f2f; }
    .dias-restantes { color: #4caf50; font-weight: 600; }
    .dias-restantes.expired { color: #999; }
    .empty-state, .loading-container {
        background: white;
        border-radius: 12px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .empty-icon { font-size: 64px; margin-bottom: 16px; }
    .empty-state h3 { margin: 0 0 8px 0; color: #333; }
    .empty-state p { margin: 0; color: #666; }
    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #0081f2;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@code {
    private List<AssinaturaDto> assinaturas = new();
    private bool isLoading = true;
    private string filterStatus = string.Empty;

    private IEnumerable<AssinaturaDto> filteredAssinaturas => assinaturas
        .Where(a => string.IsNullOrEmpty(filterStatus) || a.Status == filterStatus)
        .OrderByDescending(a => a.DataInicio);

    protected override async Task OnInitializedAsync()
    {
        await LoadAssinaturas();
    }

    private async Task LoadAssinaturas()
    {
        try
        {
            isLoading = true;
            await Task.Delay(500);
            assinaturas = GetMockAssinaturas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar assinaturas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "ACTIVE" => "badge-success",
            "EXPIRED" => "badge-warning",
            "CANCELLED" => "badge-danger",
            _ => "badge-light"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "ACTIVE" => "Ativa",
            "EXPIRED" => "Expirada",
            "CANCELLED" => "Cancelada",
            _ => status
        };
    }

    private List<AssinaturaDto> GetMockAssinaturas()
    {
        return new List<AssinaturaDto>
        {
            new() {
                Id = 1,
                ClienteNome = "João Silva",
                ClienteEmail = "joao@email.com",
                PlanoNome = "Plano Básico",
                Status = "ACTIVE",
                DataInicio = DateTime.Now.AddDays(-10),
                DataFim = DateTime.Now.AddDays(20)
            },
            new() {
                Id = 2,
                ClienteNome = "Maria Santos",
                ClienteEmail = "maria@email.com",
                PlanoNome = "Plano Intermediário",
                Status = "ACTIVE",
                DataInicio = DateTime.Now.AddDays(-5),
                DataFim = DateTime.Now.AddDays(55)
            },
            new() {
                Id = 3,
                ClienteNome = "Pedro Oliveira",
                ClienteEmail = "pedro@email.com",
                PlanoNome = "Plano Premium",
                Status = "EXPIRED",
                DataInicio = DateTime.Now.AddDays(-100),
                DataFim = DateTime.Now.AddDays(-10)
            }
        };
    }

    public class AssinaturaDto
    {
        public int Id { get; set; }
        public string ClienteNome { get; set; } = string.Empty;
        public string ClienteEmail { get; set; } = string.Empty;
        public string PlanoNome { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime DataInicio { get; set; }
        public DateTime DataFim { get; set; }
    }
}
