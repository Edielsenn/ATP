    private void OpenNewTemplateForm()
    {
        templateForm = new EmailTemplateFormDto { Ativo = true };
        isEditingTemplate = false;
        showTemplateForm = true;
        templateFormError = string.Empty;
    }

    private async Task OpenEditTemplateForm(EmailTemplateDto template)
    {
        try
        {
            Console.WriteLine($"[CONFIG] Carregando template {template.Id}...");
            var detail = await ApiService.GetAsync<EmailTemplateDetailDto>($"/api/email/templates/{template.Id}");

            if (detail != null)
            {
                templateForm = new EmailTemplateFormDto
                {
                    Id = detail.Id,
                    Nome = detail.Nome,
                    Codigo = detail.Codigo,
                    Assunto = detail.Assunto,
                    CorpoHtml = detail.CorpoHtml,
                    CorpoTexto = detail.CorpoTexto,
                    Ativo = detail.Ativo
                };

                isEditingTemplate = true;
                showTemplateForm = true;
                templateFormError = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao carregar template: {ex.Message}");
        }
    }

    private void CloseTemplateForm()
    {
        showTemplateForm = false;
        templateForm = new();
        templateFormError = string.Empty;
    }

    private async Task SaveTemplate()
    {
        try
        {
            templateFormError = string.Empty;

            if (string.IsNullOrWhiteSpace(templateForm.Nome))
            {
                templateFormError = "Nome é obrigatório";
                return;
            }

            if (!isEditingTemplate && string.IsNullOrWhiteSpace(templateForm.Codigo))
            {
                templateFormError = "Código é obrigatório";
                return;
            }

            if (string.IsNullOrWhiteSpace(templateForm.Assunto))
            {
                templateFormError = "Assunto é obrigatório";
                return;
            }

            if (string.IsNullOrWhiteSpace(templateForm.CorpoHtml))
            {
                templateFormError = "Corpo HTML é obrigatório";
                return;
            }

            isSavingTemplate = true;

            if (isEditingTemplate)
            {
                Console.WriteLine($"[CONFIG] Atualizando template {templateForm.Id}...");
                await ApiService.PutAsync<EmailTemplateFormDto, object>($"/api/email/templates/{templateForm.Id}", templateForm);
            }
            else
            {
                Console.WriteLine("[CONFIG] Criando novo template...");
                await ApiService.PostAsync<EmailTemplateFormDto, object>("/api/email/templates", templateForm);
            }

            await LoadEmailTemplates();
            CloseTemplateForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao salvar template: {ex.Message}");
            templateFormError = "Erro ao salvar template.";
        }
        finally
        {
            isSavingTemplate = false;
        }
    }

    private async Task DeleteTemplate(int id)
    {
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir este template?");
            if (!confirmed) return;

            Console.WriteLine($"[CONFIG] Deletando template {id}");
            await ApiService.DeleteAsync($"/api/email/templates/{id}");
            await LoadEmailTemplates();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao deletar template: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Não foi possível excluir o template.");
        }
    }

    private async Task InitDefaultTemplates()
    {
        try
        {
            Console.WriteLine("[CONFIG] Iniciando templates padrão...");
            await ApiService.PostAsync<object, object>("/api/email/templates/init-defaults", null);
            await LoadEmailTemplates();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao criar templates padrão: {ex.Message}");
        }
    }

