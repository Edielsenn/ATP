        {
            var walletConfig = await ApiService.GetAsync<ConfigValueResponse>("/api/configuracoes/get?key=ASAAS_SPLIT_WALLET_ID");
            var percentageConfig = await ApiService.GetAsync<ConfigValueResponse>("/api/configuracoes/get?key=ASAAS_SPLIT_PERCENTAGE");
            var fixedConfig = await ApiService.GetAsync<ConfigValueResponse>("/api/configuracoes/get?key=ASAAS_SPLIT_FIXED_VALUE");
            var enabledConfig = await ApiService.GetAsync<ConfigValueResponse>("/api/configuracoes/get?key=ASAAS_SPLIT_ENABLED");

            splitWalletId = walletConfig?.Valor ?? string.Empty;

            if (decimal.TryParse(percentageConfig?.Valor, out var pct))
                splitPercentage = pct;

            if (decimal.TryParse(fixedConfig?.Valor, out var fix))
                splitFixedValue = fix;

            splitEnabled = enabledConfig?.Valor?.ToLower() == "true";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao carregar config split: {ex.Message}");
        }
    }

    private async Task SaveSplitConfig()
    {
        try
        {
            isSavingSplit = true;
            splitFormError = string.Empty;
            splitFormSuccess = string.Empty;

            var configs = new[]
            {
                new { Key = "ASAAS_SPLIT_WALLET_ID", Value = splitWalletId ?? string.Empty },
                new { Key = "ASAAS_SPLIT_PERCENTAGE", Value = splitPercentage?.ToString() ?? "0" },
                new { Key = "ASAAS_SPLIT_FIXED_VALUE", Value = splitFixedValue?.ToString() ?? "0" },
                new { Key = "ASAAS_SPLIT_ENABLED", Value = splitEnabled.ToString().ToLower() }
            };

            foreach (var config in configs)
            {
                await ApiService.PostAsync<object, object>("/api/configuracoes/set", config);
            }

            splitFormSuccess = "Configuração de split salva com sucesso!";
            await Task.Delay(2000);
            splitFormSuccess = string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao salvar split: {ex.Message}");
            splitFormError = "Erro ao salvar configuração de split.";
        }
        finally
        {
            isSavingSplit = false;
        }
    }

    // Email methods
    private async Task OpenEmailConfig()
    {
        showEmailModal = true;
        showTemplateForm = false;
        await LoadSmtpConfig();
        await LoadEmailTemplates();
    }

    private void CloseEmailModal()
    {
        showEmailModal = false;
        showTemplateForm = false;
        showTestEmailDialog = false;
        templateForm = new();
    }

    private async Task LoadSmtpConfig()
    {
        try
        {
            Console.WriteLine("[CONFIG] Carregando config SMTP...");
            var config = await ApiService.GetAsync<SmtpConfigDto>("/api/email/smtp-config");

            if (config != null)
            {
                smtpHost = config.Host ?? "";
                smtpPort = config.Port ?? "587";
                smtpUsername = config.Username ?? "";
                smtpPassword = config.Password ?? "";
                smtpFromEmail = config.FromEmail ?? "";
                smtpFromName = config.FromName ?? "CNH Virtual";
                smtpUseSsl = config.UseSsl;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao carregar SMTP: {ex.Message}");
        }
    }

    private async Task SaveSmtpConfig()
    {
        try
        {
            isSavingSmtp = true;
            smtpFormError = string.Empty;
            smtpFormSuccess = string.Empty;

            if (string.IsNullOrWhiteSpace(smtpHost) || string.IsNullOrWhiteSpace(smtpPort) ||
                string.IsNullOrWhiteSpace(smtpUsername) || string.IsNullOrWhiteSpace(smtpPassword))
            {
                smtpFormError = "Por favor, preencha todos os campos obrigatórios";
                return;
            }

            var request = new
            {
                Host = smtpHost,
                Port = smtpPort,
                Username = smtpUsername,
                Password = smtpPassword,
                FromEmail = smtpFromEmail,
                FromName = smtpFromName,
                UseSsl = smtpUseSsl
            };

            await ApiService.PostAsync<object, object>("/api/email/smtp-config", request);
            smtpFormSuccess = "Configuração SMTP salva com sucesso!";

            await Task.Delay(2000);
            smtpFormSuccess = string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao salvar SMTP: {ex.Message}");
            smtpFormError = "Erro ao salvar configuração SMTP.";
        }
        finally
        {
            isSavingSmtp = false;
        }
    }

    private void ShowTestEmailDialog()
    {
        showTestEmailDialog = !showTestEmailDialog;
        if (!showTestEmailDialog)
        {
            testEmail = string.Empty;
        }
    }

    private async Task TestSmtpConfig()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(testEmail))
            {
                smtpFormError = "Por favor, informe um email para teste";
                return;
            }

            isTestingSmtp = true;
            smtpFormError = string.Empty;
            smtpFormSuccess = string.Empty;

            var result = await ApiService.PostAsync<object, object>("/api/email/test", new { EmailTeste = testEmail });

            if (result != null)
            {
                smtpFormSuccess = "Email de teste enviado! Verifique sua caixa de entrada.";
                showTestEmailDialog = false;
                testEmail = string.Empty;

                await Task.Delay(3000);
                smtpFormSuccess = string.Empty;
            }
            else
            {
                smtpFormError = "Falha ao enviar email de teste. Verifique as configurações.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CONFIG] Erro ao testar email: {ex.Message}");
            smtpFormError = "Erro ao enviar email de teste.";
        }
        finally
        {
            isTestingSmtp = false;
        }
    }

