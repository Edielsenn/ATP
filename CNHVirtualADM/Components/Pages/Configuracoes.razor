@page "/configuracoes"
@rendermode InteractiveServer

<PageTitle>Configurações - CNH Virtual Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Configurações</h1>
            <p>Configurações do sistema</p>
        </div>
    </div>

    <div class="config-sections">
        <div class="config-card">
            <div class="config-icon">🔐</div>
            <h3>Autenticação</h3>
            <p>Configurações de login e segurança</p>
            <button class="btn-config">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">💳</div>
            <h3>ASAAS Integration</h3>
            <p>Chaves de API e configurações de pagamento</p>
            <button class="btn-config">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">📧</div>
            <h3>Email</h3>
            <p>Configurações SMTP e templates</p>
            <button class="btn-config">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">🎓</div>
            <h3>iCondutor</h3>
            <p>Integração com plataforma de cursos</p>
            <button class="btn-config">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">🔔</div>
            <h3>Webhooks</h3>
            <p>URLs e eventos de webhooks</p>
            <button class="btn-config">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">⚙️</div>
            <h3>Sistema</h3>
            <p>Configurações gerais do sistema</p>
            <button class="btn-config">Configurar</button>
        </div>
    </div>
</div>

<style>
    .page-container {
        padding: 20px;
    }

    .page-header {
        margin-bottom: 40px;
    }

    .page-header h1 {
        margin: 0 0 8px 0;
        font-size: 32px;
        color: #333;
    }

    .page-header p {
        margin: 0;
        color: #666;
    }

    .config-sections {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
    }

    .config-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .config-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .config-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }

    .config-card h3 {
        margin: 0 0 8px 0;
        font-size: 20px;
        color: #333;
    }

    .config-card p {
        margin: 0 0 20px 0;
        color: #666;
        font-size: 14px;
        line-height: 1.5;
    }

    .btn-config {
        padding: 10px 24px;
        background: #0081f2;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }

    .btn-config:hover {
        background: #0066c2;
    }
</style>

