@page "/configuracoes"
@rendermode InteractiveServer
@inject ApiService ApiService
@inject IJSRuntime JS

<PageTitle>Configurações - CNH Virtual Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Configurações</h1>
            <p>Configurações do sistema</p>
        </div>
    </div>

    <div class="config-sections">
        <div class="config-card">
            <div class="config-icon">🔐</div>
            <h3>Autenticação</h3>
            <p>Configurações de login e segurança</p>
            <button class="btn-config" @onclick="OpenAuthConfig">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">💳</div>
            <h3>ASAAS Integration</h3>
            <p>Chaves de API e configurações de pagamento</p>
            <button class="btn-config" @onclick="OpenAsaasConfig">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">📧</div>
            <h3>Email</h3>
            <p>Configurações SMTP e templates</p>
            <button class="btn-config" @onclick="OpenEmailConfig">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">🎓</div>
            <h3>iCondutor</h3>
            <p>Integração com plataforma de cursos</p>
            <button class="btn-config">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">🔔</div>
            <h3>Webhooks</h3>
            <p>URLs e eventos de webhooks</p>
            <button class="btn-config" @onclick="OpenWebhooksConfig">Configurar</button>
        </div>

        <div class="config-card">
            <div class="config-icon">⚙️</div>
            <h3>Sistema</h3>
            <p>Configurações gerais do sistema</p>
            <button class="btn-config">Configurar</button>
        </div>
    </div>
</div>

@if (showAsaasModal)
{
    <div class="modal-overlay" @onclick="CloseAsaasConfig">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Configuração ASAAS</h2>
                <button class="btn-close" @onclick="CloseAsaasConfig">×</button>
            </div>

            <div class="modal-body">
                @if (isLoading)
                {
                    <p>Carregando...</p>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-error">@errorMessage</div>
                }
                else if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                <div class="form-group">
                    <label>API Key ASAAS</label>
                    <input type="text"
                           class="form-control"
                           @bind="asaasApiKey"
                           placeholder="$aact_..." />
                    <small class="form-text">Chave de API de produção ou sandbox do ASAAS</small>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="isAsaasSandbox" />
                        Modo Sandbox (Testes)
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAsaasConfig">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveAsaasConfig" disabled="@isLoading">
                    @(isLoading ? "Salvando..." : "Salvar")
                </button>
            </div>
        </div>
    </div>
}

@if (showAuthModal)
{
    <div class="modal-overlay" @onclick="CloseAuthModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Gerenciamento de Usuários</h2>
                <button class="btn-close" @onclick="CloseAuthModal">×</button>
            </div>

            <div class="modal-body">
                @if (!showUserForm)
                {
                    <div class="users-header">
                        <h3>Usuários Administrativos</h3>
                        <button class="btn btn-primary" @onclick="OpenNewUserForm">➕ Novo Usuário</button>
                    </div>

                    @if (isLoadingUsers)
                    {
                        <p>Carregando usuários...</p>
                    }
                    else if (adminUsers.Any())
                    {
                        <div class="users-table">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Criado em</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in adminUsers)
                                    {
                                        <tr class="@(!user.Ativo ? "inactive-row" : "")">
                                            <td>@user.Nome</td>
                                            <td>@user.Email</td>
                                            <td>
                                                <span class="status-badge @(user.Ativo ? "active" : "inactive")">
                                                    @(user.Ativo ? "Ativo" : "Inativo")
                                                </span>
                                            </td>
                                            <td>@user.DataCriacao.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="btn-icon" @onclick="() => OpenEditUserForm(user)" title="Editar">✏️</button>
                                                    <button class="btn-icon" @onclick="() => ToggleUserStatus(user.Id)" title="@(user.Ativo ? "Desativar" : "Ativar")">
                                                        @(user.Ativo ? "🔴" : "🟢")
                                                    </button>
                                                    <button class="btn-icon" @onclick="() => DeleteUser(user.Id)" title="Excluir">🗑️</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-users">
                            <p>Nenhum usuário cadastrado</p>
                        </div>
                    }
                }
                else
                {
                    <!-- User Form -->
                    <div class="user-form">
                        <h3>@(isEditingUser ? "Editar Usuário" : "Novo Usuário")</h3>

                        @if (!string.IsNullOrEmpty(userFormError))
                        {
                            <div class="alert alert-error">@userFormError</div>
                        }

                        <div class="form-group">
                            <label>Nome Completo *</label>
                            <input type="text" class="form-control" @bind="userForm.Nome" placeholder="Nome do usuário" />
                        </div>

                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" class="form-control" @bind="userForm.Email" placeholder="email@exemplo.com" />
                        </div>

                        <div class="form-group">
                            <label>@(isEditingUser ? "Nova Senha (deixe em branco para não alterar)" : "Senha *")</label>
                            <input type="password" class="form-control" @bind="userForm.Senha" placeholder="********" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(userForm.Senha))
                        {
                            <div class="form-group">
                                <label>Confirmar Senha *</label>
                                <input type="password" class="form-control" @bind="userForm.ConfirmarSenha" placeholder="********" />
                            </div>
                        }

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="userForm.Ativo" />
                                <span>Usuário Ativo</span>
                            </label>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-secondary" @onclick="CloseUserForm">Cancelar</button>
                            <button class="btn btn-primary" @onclick="SaveUser" disabled="@isSavingUser">
                                @(isSavingUser ? "Salvando..." : "Salvar")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (showWebhooksModal)
{
    <div class="modal-overlay" @onclick="CloseWebhooksModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Gerenciamento de Webhooks</h2>
                <button class="btn-close" @onclick="CloseWebhooksModal">×</button>
            </div>

            <div class="modal-body">
                <!-- Split ASAAS Configuration -->
                <div class="config-section">
                    <h3>🔗 Split ASAAS</h3>
                    <p class="section-description">Configure como os pagamentos serão divididos entre diferentes carteiras</p>

                    @if (!string.IsNullOrEmpty(splitFormError))
                    {
                        <div class="alert alert-error">@splitFormError</div>
                    }
                    @if (!string.IsNullOrEmpty(splitFormSuccess))
                    {
                        <div class="alert alert-success">@splitFormSuccess</div>
                    }

                    <div class="form-group">
                        <label>Wallet ID Principal</label>
                        <input type="text" class="form-control" @bind="splitWalletId" placeholder="wallet_id_aqui" />
                        <small class="form-text">ID da carteira que receberá a divisão dos pagamentos</small>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Percentual de Split (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="splitPercentage" placeholder="0.00" />
                        </div>
                        <div class="form-group">
                            <label>Valor Fixo de Split (R$)</label>
                            <input type="number" step="0.01" class="form-control" @bind="splitFixedValue" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="splitEnabled" />
                            <span>Split Habilitado</span>
                        </label>
                    </div>

                    <button class="btn btn-primary" @onclick="SaveSplitConfig" disabled="@isSavingSplit">
                        @(isSavingSplit ? "Salvando..." : "Salvar Split")
                    </button>
                </div>

                <hr class="section-divider" />

                <!-- Webhooks List/Form -->
                @if (!showWebhookForm)
                {
                    <div class="webhooks-header">
                        <h3>📡 Subscrições de Webhooks</h3>
                        <button class="btn btn-primary" @onclick="OpenNewWebhookForm">➕ Novo Webhook</button>
                    </div>

                    @if (isLoadingWebhooks)
                    {
                        <p>Carregando webhooks...</p>
                    }
                    else if (webhooks.Any())
                    {
                        <div class="webhooks-list">
                            @foreach (var webhook in webhooks)
                            {
                                <div class="webhook-item @(!webhook.Ativo ? "inactive" : "")">
                                    <div class="webhook-header-item">
                                        <div>
                                            <h4>@webhook.Nome</h4>
                                            <p class="webhook-url">@webhook.Url</p>
                                            <span class="status-badge @(webhook.Ativo ? "active" : "inactive")">
                                                @(webhook.Ativo ? "Ativo" : "Inativo")
                                            </span>
                                        </div>
                                        <div class="action-buttons">
                                            <button class="btn-icon" @onclick="() => OpenEditWebhookForm(webhook)" title="Editar">✏️</button>
                                            <button class="btn-icon" @onclick="() => ToggleWebhookStatus(webhook.Id)" title="@(webhook.Ativo ? "Desativar" : "Ativar")">
                                                @(webhook.Ativo ? "🔴" : "🟢")
                                            </button>
                                            <button class="btn-icon" @onclick="() => DeleteWebhook(webhook.Id)" title="Excluir">🗑️</button>
                                        </div>
                                    </div>
                                    <div class="webhook-events">
                                        <strong>Eventos:</strong> @GetEventosText(webhook.Eventos)
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-webhooks">
                            <p>Nenhum webhook cadastrado</p>
                        </div>
                    }
                }
                else
                {
                    <!-- Webhook Form -->
                    <div class="webhook-form">
                        <h3>@(isEditingWebhook ? "Editar Webhook" : "Novo Webhook")</h3>

                        @if (!string.IsNullOrEmpty(webhookFormError))
                        {
                            <div class="alert alert-error">@webhookFormError</div>
                        }

                        <div class="form-group">
                            <label>Nome *</label>
                            <input type="text" class="form-control" @bind="webhookForm.Nome" placeholder="Nome descritivo" />
                        </div>

                        <div class="form-group">
                            <label>URL do Webhook *</label>
                            <input type="url" class="form-control" @bind="webhookForm.Url" placeholder="https://exemplo.com/webhook" />
                        </div>

                        <div class="form-group">
                            <label>Secret (opcional)</label>
                            <input type="text" class="form-control" @bind="webhookForm.Secret" placeholder="Chave secreta para validação" />
                            <small class="form-text">Usado para validar a origem do webhook</small>
                        </div>

                        <div class="form-group">
                            <label>Eventos</label>
                            <div class="eventos-checkboxes">
                                @foreach (var evt in eventosDisponiveis)
                                {
                                    <label class="checkbox-label">
                                        <input type="checkbox"
                                               checked="@IsEventoSelecionado(evt.Value)"
                                               @onchange="e => ToggleEvento(evt.Value, (bool)e.Value!)" />
                                        <span>@evt.Key</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="webhookForm.Ativo" />
                                <span>Webhook Ativo</span>
                            </label>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-secondary" @onclick="CloseWebhookForm">Cancelar</button>
                            <button class="btn btn-primary" @onclick="SaveWebhook" disabled="@isSavingWebhook">
                                @(isSavingWebhook ? "Salvando..." : "Salvar")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (showEmailModal)
{
    <div class="modal-overlay" @onclick="CloseEmailModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Configurações de Email</h2>
                <button class="btn-close" @onclick="CloseEmailModal">×</button>
            </div>

            <div class="modal-body">
                <!-- SMTP Configuration -->
                <div class="config-section">
                    <h3>📧 Configuração SMTP</h3>
                    <p class="section-description">Configure o servidor de email para envio de mensagens</p>

                    @if (!string.IsNullOrEmpty(smtpFormError))
                    {
                        <div class="alert alert-error">@smtpFormError</div>
                    }
                    @if (!string.IsNullOrEmpty(smtpFormSuccess))
                    {
                        <div class="alert alert-success">@smtpFormSuccess</div>
                    }

                    <div class="form-row">
                        <div class="form-group">
                            <label>Servidor SMTP (Host) *</label>
                            <input type="text" class="form-control" @bind="smtpHost" placeholder="smtp.gmail.com" />
                        </div>
                        <div class="form-group">
                            <label>Porta *</label>
                            <input type="number" class="form-control" @bind="smtpPort" placeholder="587" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Usuário / Email *</label>
                            <input type="text" class="form-control" @bind="smtpUsername" placeholder="seu-email@gmail.com" />
                        </div>
                        <div class="form-group">
                            <label>Senha *</label>
                            <input type="password" class="form-control" @bind="smtpPassword" placeholder="********" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Email Remetente</label>
                            <input type="email" class="form-control" @bind="smtpFromEmail" placeholder="noreply@cnhvirtual.com" />
                            <small class="form-text">Se vazio, usará o usuário/email</small>
                        </div>
                        <div class="form-group">
                            <label>Nome do Remetente</label>
                            <input type="text" class="form-control" @bind="smtpFromName" placeholder="CNH Virtual" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="smtpUseSsl" />
                            <span>Usar SSL/TLS</span>
                        </label>
                    </div>

                    <div class="form-actions-inline">
                        <button class="btn btn-primary" @onclick="SaveSmtpConfig" disabled="@isSavingSmtp">
                            @(isSavingSmtp ? "Salvando..." : "Salvar Configuração")
                        </button>
                        <button class="btn btn-secondary" @onclick="ShowTestEmailDialog" disabled="@isSavingSmtp">
                            🧪 Testar Envio
                        </button>
                    </div>

                    @if (showTestEmailDialog)
                    {
                        <div class="test-email-section">
                            <h4>Testar Configuração SMTP</h4>
                            <div class="form-group">
                                <label>Email para Teste</label>
                                <input type="email" class="form-control" @bind="testEmail" placeholder="seu-email@exemplo.com" />
                            </div>
                            <button class="btn btn-primary" @onclick="TestSmtpConfig" disabled="@isTestingSmtp">
                                @(isTestingSmtp ? "Enviando..." : "Enviar Email de Teste")
                            </button>
                        </div>
                    }
                </div>

                <hr class="section-divider" />

                <!-- Email Templates -->
                @if (!showTemplateForm)
                {
                    <div class="templates-header">
                        <h3>📝 Templates de Email</h3>
                        <button class="btn btn-primary" @onclick="OpenNewTemplateForm">➕ Novo Template</button>
                    </div>

                    @if (isLoadingTemplates)
                    {
                        <p>Carregando templates...</p>
                    }
                    else if (emailTemplates.Any())
                    {
                        <div class="templates-list">
                            @foreach (var template in emailTemplates)
                            {
                                <div class="template-item @(!template.Ativo ? "inactive" : "")">
                                    <div class="template-header">
                                        <div>
                                            <h4>@template.Nome</h4>
                                            <p class="template-code">@template.Codigo</p>
                                            <p class="template-subject">@template.Assunto</p>
                                            <span class="status-badge @(template.Ativo ? "active" : "inactive")">
                                                @(template.Ativo ? "Ativo" : "Inativo")
                                            </span>
                                        </div>
                                        <div class="action-buttons">
                                            <button class="btn-icon" @onclick="() => OpenEditTemplateForm(template)" title="Editar">✏️</button>
                                            @if (template.Codigo != "CREDENCIAIS_ACESSO" && template.Codigo != "BEM_VINDO")
                                            {
                                                <button class="btn-icon" @onclick="() => DeleteTemplate(template.Id)" title="Excluir">🗑️</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-templates">
                            <p>Nenhum template cadastrado</p>
                            <button class="btn btn-primary" @onclick="InitDefaultTemplates">
                                Criar Templates Padrão
                            </button>
                        </div>
                    }
                }
                else
                {
                    <!-- Template Form -->
                    <div class="template-form">
                        <h3>@(isEditingTemplate ? "Editar Template" : "Novo Template")</h3>

                        @if (!string.IsNullOrEmpty(templateFormError))
                        {
                            <div class="alert alert-error">@templateFormError</div>
                        }

                        <div class="form-group">
                            <label>Nome *</label>
                            <input type="text" class="form-control" @bind="templateForm.Nome" placeholder="Nome descritivo" />
                        </div>

                        @if (!isEditingTemplate)
                        {
                            <div class="form-group">
                                <label>Código *</label>
                                <input type="text" class="form-control" @bind="templateForm.Codigo" placeholder="CODIGO_TEMPLATE" />
                                <small class="form-text">Identificador único (ex: CREDENCIAIS_ACESSO)</small>
                            </div>
                        }

                        <div class="form-group">
                            <label>Assunto *</label>
                            <input type="text" class="form-control" @bind="templateForm.Assunto" placeholder="Assunto do email" />
                            <small class="form-text">Variáveis: {{NOME_CLIENTE}}, {{CPF}}, {{SENHA}}</small>
                        </div>

                        <div class="form-group">
                            <label>Corpo HTML *</label>
                            <textarea class="form-control" @bind="templateForm.CorpoHtml" rows="10" placeholder="<html>...</html>"></textarea>
                            <small class="form-text">Variáveis disponíveis: {{NOME_CLIENTE}}, {{CPF}}, {{SENHA}}, {{URL_ACESSO}}</small>
                        </div>

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="templateForm.Ativo" />
                                <span>Template Ativo</span>
                            </label>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-secondary" @onclick="CloseTemplateForm">Cancelar</button>
                            <button class="btn btn-primary" @onclick="SaveTemplate" disabled="@isSavingTemplate">
                                @(isSavingTemplate ? "Salvando..." : "Salvar")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .page-container {
        padding: 20px;
    }

    .page-header {
        margin-bottom: 40px;
    }

    .page-header h1 {
        margin: 0 0 8px 0;
        font-size: 32px;
        color: #333;
    }

    .page-header p {
        margin: 0;
        color: #666;
    }

    .config-sections {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
    }

    .config-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .config-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .config-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }

    .config-card h3 {
        margin: 0 0 8px 0;
        font-size: 20px;
        color: #333;
    }

    .config-card p {
        margin: 0 0 20px 0;
        color: #666;
        font-size: 14px;
        line-height: 1.5;
    }

    .btn-config {
        padding: 10px 24px;
        background: #0081f2;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }

    .btn-config:hover {
        background: #0066c2;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        max-width: 600px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
        padding: 24px;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h2 {
        margin: 0;
        font-size: 24px;
        color: #333;
    }

    .btn-close {
        background: none;
        border: none;
        font-size: 32px;
        color: #999;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        line-height: 1;
    }

    .btn-close:hover {
        color: #333;
    }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        padding: 24px;
        border-top: 1px solid #e0e0e0;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
